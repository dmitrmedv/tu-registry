NODE_ENV=development
# Must match the Vite proxy target in client/vite.config.ts
API_PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Replica set is required (transactions). Local: `npm run db:start -w server`
MONGO_URI=mongodb://127.0.0.1:27017/tu_registry?replicaSet=rs0

# First administrator, used only by `npm run db:seed` (password: at least 10 characters)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NAME=Адміністратор системи
SEED_ADMIN_PASSWORD=
# Department of the first administrator (an id from packages/shared/src/departments.ts)
SEED_ADMIN_DEPARTMENT=ODESA

# Access token signing secret, at least 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
# Session ends after this many hours without activity
SESSION_TTL_HOURS=12
# true only behind a trusted reverse proxy
TRUST_PROXY=false
BCRYPT_COST=12
