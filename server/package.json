{
  "name": "@tu-registry/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "db:indexes": "tsx --env-file=.env src/scripts/syncIndexes.ts",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "db:start": "tsx src/scripts/devMongo.ts start",
    "db:stop": "tsx src/scripts/devMongo.ts stop",
    "db:status": "tsx src/scripts/devMongo.ts status",
    "db:demo": "tsx --env-file=.env src/scripts/demoData.ts",
    "e2e:server": "tsx src/scripts/e2eServer.ts"
  },
  "dependencies": {
    "@tu-registry/shared": "^0.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
